{
	"extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
	"env": {
		"browser": true,
		"node": true
	},
	"globals": {
		"Swiper": "readonly",
		"refreshFsLightbox": "readonly"
	},
	"rules": {
		// TODO: fix in follow-up PR
		"jsdoc/require-param": "warn",
		"jsdoc/require-param-type": "warn",
		"jsdoc/check-param-names": "warn",
		"jsdoc/require-returns-description": "warn",
		"no-unused-vars": "warn",
		"import/no-unresolved": [
			"error",
			{
				"ignore": [
					"^@(Controls|Components|Utils|Constants|Blocks|Store|Attributes)(/|$)",
					"^__real_wordpress_block_editor$",
					"^@wordpress/"
				]
			}
		],
		"import/no-extraneous-dependencies": "warn",
		// TODO: remaining debt, fix in dedicated refactor PRs
		"no-nested-ternary": "warn",
		"camelcase": "warn",
		"no-shadow": "warn",
		"react/jsx-no-target-blank": "warn",
		"react/no-unescaped-entities": "warn",
		"@wordpress/i18n-no-variables": "warn",
		"@wordpress/i18n-no-flanking-whitespace": "warn",
		"@wordpress/no-base-control-with-label-without-id": "warn",
		"@wordpress/no-unused-vars-before-return": "warn",
		"jsx-a11y/click-events-have-key-events": "warn",
		"jsx-a11y/no-static-element-interactions": "warn",
		"jsx-a11y/label-has-associated-control": "warn",
		"no-console": "warn"
	},
	"overrides": [
		{
			"files": [ "storybook/**/*.{js,jsx}" ],
			"rules": {
				"react-hooks/rules-of-hooks": "warn"
			}
		}
	]
}
