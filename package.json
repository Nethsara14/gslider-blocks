{
	"name": "gslider-blocks",
	"version": "1.1.9",
	"description": "gslider Blocks",
	"author": "Noruzzaman",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build && npm run defaults:generate",
		"defaults:generate": "node scripts/generate-block-defaults.js",
		"build:production": "wp-scripts build --mode=production && npm run defaults:generate",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"zip": "node webpack.zip.js",
		"admin": "webpack --config webpack.config.admin.js --watch --mode=development",
		"admin:build": "webpack --config webpack.config.admin.js --mode=production",
		"mcp:build": "npm --prefix packages/mcp-server run build",
		"mcp:start": "npm --prefix packages/mcp-server run start",
		"mcp:test": "npm --prefix packages/mcp-server run test"
	},
	"devDependencies": {
		"@monaco-editor/react": "^4.6.0",
		"@wordpress/babel-preset-default": "^8.26.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^6.26.0",
		"@wordpress/scripts": "^30.17.0",
		"babel-loader": "^9.2.1",
		"css-loader": "^7.1.2",
		"mini-css-extract-plugin": "^2.9.2",
		"sass": "^1.88.0",
		"sass-loader": "^16.0.5",
		"webpack": "^5.99.8",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"archiver": "^7.0.1",
		"react-select": "^5.10.1",
		"react-virtualized": "^9.22.5",
		"swiper": "^11.2.6"
	}
}
