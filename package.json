{
	"name": "gslider-blocks",
	"version": "1.2.0",
	"description": "gslider Blocks",
	"author": "Noruzzaman",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.22.2"
	},
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build && npm run defaults:generate",
		"defaults:generate": "node scripts/generate-block-defaults.js",
		"build:production": "wp-scripts build --mode=production && npm run defaults:generate",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"zip": "node webpack.zip.js",
		"admin": "webpack --config webpack.config.admin.js --watch --mode=development",
		"admin:build": "webpack --config webpack.config.admin.js --mode=production",
		"mcp:build": "npm --prefix packages/mcp-server run build",
		"mcp:start": "npm --prefix packages/mcp-server run start",
		"mcp:test": "npm --prefix packages/mcp-server run test",
		"test": "npm run test:php",
		"test:php": "composer test",
		"storybook": "storybook dev -c storybook -p 6006 --disable-telemetry",
		"storybook:build": "storybook build -c storybook -o storybook-static --disable-telemetry"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^8.6.19",
		"@storybook/addon-essentials": "^8.6.19",
		"@storybook/addon-interactions": "^8.6.19",
		"@storybook/blocks": "^8.6.19",
		"@storybook/manager-api": "^8.6.19",
		"@storybook/preview-api": "^8.6.19",
		"@storybook/react-webpack5": "^8.6.19",
		"@storybook/test": "^8.6.19",
		"@storybook/theming": "^8.6.19",
		"@wordpress/babel-preset-default": "^8.56.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^6.57.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/scripts": "^30.27.0",
		"babel-loader": "^10.1.1",
		"css-loader": "^7.1.5",
		"esbuild": "^0.27.7",
		"mini-css-extract-plugin": "^2.10.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.105.2",
		"sass-loader": "^17.0.1",
		"storybook": "^8.6.19",
		"style-loader": "^4.0.0",
		"webpack": "^5.99.8",
		"webpack-cli": "^7.2.3"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"archiver": "^7.0.1",
		"react-select": "^5.10.1",
		"react-virtualized": "^9.22.5",
		"swiper": "^11.2.6"
	},
	"overrides": {
		"markdown-it": "^14.3.3",
		"postcss-selector-parser": "^7.1.7"
	}
}
