{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gslider-blocks/logo-carousel",
	"version": "1.0.0",
	"title": "Logo Carousel",
	"category": "gslider-blocks",
	"description": "Scrollable carousel for client/brand logos.",
	"keywords": [
		"logo",
		"logos",
		"client logo",
		"brand",
		"brand Logo",
		"partner",
		"carousel",
		"slider",
		"logo carousel",
		"logo slider"
