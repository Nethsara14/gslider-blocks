{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "gutenslider-blocks/gutenslider",
	"version": "1.0.0",
	"title": "GutenSlider",
	"icon": "slides",
	"category": "gutenslider-blocks",
	"description": "Slider block",
	"example": {
		"attributes": {
		  "preview": true
		},
		"viewportWidth": 410
	  },
	"supports": {
		"html": false,
		"anchor": false,
		"customClassName": false,
		"align": ["wide", "full"]
	},
	"textdomain": "gutenslider-blocks",
	"editorScript": [
		"file:./index.js"
	],
	"editorStyle": [
		"file:./index.css"
	],
	"style": [
		"file:./style-index.css",
		"gutenslider-blocks-swiper-style"
	],
	"viewScript": [
		"file:./view.js"
	],
	"script": [
		"gutenslider-blocks-swiper-script"
	]
}
