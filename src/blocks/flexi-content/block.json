{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gslider-blocks/flexi-content",
	"version": "1.2.0",
	"title": "Flexi Content",
	"category": "gslider-blocks",
	"description": "Display any content seamlessly in slide or carousel modes.",
	"keywords": [
		"flexi",
		"content slider",
		"custom slider",
		"innerblocks",
		"carousel",
		"slideshow",
		"slider"
	],
	"example": {
		"attributes": {
		  "preview": true
		},
		"viewportWidth": 410
	  },
	"supports": {
		"html": false,
		"anchor": false,
		"align": ["wide", "full"]
	},
	"textdomain": "gslider-blocks",
	"editorScript": [
		"file:./index.js",
		"gslider-blocks-swiper-script"
	],
	"editorStyle": [
		"file:./index.css",
		"gslider-blocks-swiper-style"
	],
	"style": [
		"file:./style-index.css",
		"gslider-blocks-swiper-style"
	],
	"viewScript": [
		"file:./view.js",
		"gslider-blocks-swiper-script"
	]
}
