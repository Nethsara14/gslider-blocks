{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gslider-blocks/testimonial",
	"version": "1.2.0",
	"title": "Testimonial",
	"category": "gslider-blocks",
	"description": "Display customer testimonials in slider, carousel, or grid layout with star ratings.",
	"keywords": [
		"testimonial",
		"review",
		"quote",
		"rating",
		"stars",
		"feedback",
		"customer review",
		"slider",
		"carousel"
	],
	"example": {
		"attributes": {
		  "preview": true
		},
		"viewportWidth": 410
	  },
	"supports": {
		"html": false,
		"anchor": false,
		"align": ["wide", "full"]
	},
	"textdomain": "gslider-blocks",
	"editorScript": [
		"file:./index.js",
		"gslider-blocks-swiper-script"
	],
	"editorStyle": [
		"file:./index.css",
		"gslider-blocks-swiper-style"
	],
	"style": [
		"file:./style-index.css",
		"gslider-blocks-swiper-style"
	],
	"viewScript": [
		"file:./view.js",
		"gslider-blocks-swiper-script"
	]
}
